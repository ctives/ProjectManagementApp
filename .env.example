# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# Optional: Upstash Redis Configuration (for production rate limiting)
# Sign up at: https://upstash.com
# Only needed if you want distributed rate limiting across multiple instances
# For development, the built-in in-memory rate limiting is sufficient
# UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# Next.js Environment
NODE_ENV=development
